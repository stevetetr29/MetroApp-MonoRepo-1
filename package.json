{
  "name": "metroapp-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "description": "MetroApp — a location-based transit game. Expo mobile client, Next.js admin portal, Supabase backend.",
  "workspaces": [
